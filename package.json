{
  "name": "ai-render-suite",
  "version": "0.1.0",
  "private": true,
  "description": "AI render tools for SketchUp and the browser. Bring your own Gemini key or local ComfyUI.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "typecheck": "tsc --noEmit -p web",
    "test": "esbuild web/test/*.test.ts --bundle --platform=node --format=esm --outdir=dist/test --out-extension:.js=.mjs --log-level=warning && node --test dist/test/*.test.mjs",
    "rbz": "node scripts/build.mjs && node scripts/package-rbz.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.24.2",
    "typescript": "5.9.3"
  }
}
