{
  "name": "ai-render-suite",
  "version": "0.2.0-beta",
  "private": true,
  "description": "AI render tools for SketchUp and the browser. Bring your own Gemini key or local ComfyUI.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "typecheck": "tsc --noEmit -p web",
    "test": "esbuild web/test/*.test.ts --bundle --platform=node --format=esm --outdir=dist/test --out-extension:.js=.mjs --log-level=warning && node --test dist/test/*.test.mjs && npm run test:app",
    "rbz": "node scripts/build.mjs && node scripts/package-rbz.mjs",
    "build:app": "node scripts/build-app.mjs",
    "dev:app": "node scripts/build-app.mjs --serve",
    "test:app": "esbuild app/test/*.test.ts --bundle --platform=node --format=esm --outdir=dist/test-app --out-extension:.js=.mjs --log-level=warning --define:__PREVIEW_BASE__='\"previews/\"' && node --test dist/test-app/*.test.mjs",
    "typecheck:app": "tsc --noEmit -p app"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.24.2",
    "typescript": "5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
